{
  "title": "KKBox Churn — Pipeline Monitoring",
  "uid": "kkbox-monitoring",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Cohort Size Over Time",
      "description": "Number of users processed per pipeline run. Alert if < 100.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "kkbox_pg" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 100 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "kkbox_pg" },
          "format": "time_series",
          "rawSql": "SELECT run_date::timestamp AS time, metric_value AS \"cohort_size\", pipeline_type AS metric FROM monitoring_metrics WHERE metric_name = 'cohort_size' AND run_date::timestamp >= $__timeFrom() AND run_date::timestamp <= $__timeTo() ORDER BY run_date",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Model AUC-PR Over Time",
      "description": "val_auc_pr from training runs + auc_pr from monthly performance monitoring. Alert threshold: 0.45.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "kkbox_pg" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.45 },
              { "color": "green", "value": 0.6 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "kkbox_pg" },
          "format": "time_series",
          "rawSql": "SELECT run_date::timestamp AS time, metric_value AS \"AUC-PR\", pipeline_type FROM monitoring_metrics WHERE metric_name IN ('val_auc_pr', 'auc_pr') AND run_date::timestamp >= $__timeFrom() AND run_date::timestamp <= $__timeTo() ORDER BY run_date",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Feature Drift PSI — Latest Run",
      "description": "PSI per feature from the most recent drift check. PSI > 0.2 triggers an alert (structural drift on log features near month start is expected).",
      "type": "table",
      "gridPos": { "x": 0, "y": 8, "w": 14, "h": 10 },
      "datasource": { "type": "postgres", "uid": "kkbox_pg" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "color-background-solid",
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "psi" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.1 },
                    { "color": "red", "value": 0.2 }
                  ]
                }
              },
              { "id": "decimals", "value": 4 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "ALERT": { "color": "red", "index": 0 } } },
                  { "type": "value", "options": { "OK": { "color": "green", "index": 1 } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "psi", "desc": true }],
        "footer": { "show": false }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "kkbox_pg" },
          "format": "table",
          "rawSql": "SELECT REPLACE(metric_name, 'psi_', '') AS feature, ROUND(metric_value::numeric, 4) AS psi, CASE WHEN alert_triggered THEN 'ALERT' ELSE 'OK' END AS status FROM monitoring_metrics WHERE pipeline_type = 'data_drift' AND metric_name LIKE 'psi_%' AND run_date = (SELECT MAX(run_date) FROM monitoring_metrics WHERE pipeline_type = 'data_drift') ORDER BY metric_value DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Alerts (Last 20)",
      "description": "All rows where alert_triggered = TRUE across all pipelines.",
      "type": "table",
      "gridPos": { "x": 14, "y": 8, "w": 10, "h": 10 },
      "datasource": { "type": "postgres", "uid": "kkbox_pg" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "metric_value" },
            "properties": [{ "id": "decimals", "value": 4 }]
          }
        ]
      },
      "options": { "footer": { "show": false } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "kkbox_pg" },
          "format": "table",
          "rawSql": "SELECT run_date, pipeline_type, metric_name, ROUND(metric_value::numeric, 4) AS metric_value FROM monitoring_metrics WHERE alert_triggered = TRUE ORDER BY run_date DESC, pipeline_type LIMIT 20",
          "refId": "A"
        }
      ]
    }
  ]
}
